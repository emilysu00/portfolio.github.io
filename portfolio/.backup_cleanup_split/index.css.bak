/* hero (parallax tags) */
.hero {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  padding-top: 4vh; /* keep space for nav */
}

.hero__type {
  position: relative;
  z-index: 2;
  padding: 10vh 0vw 6vh;
  font-family: "Abhaya Libre";
  color: var(--blue);
}

.hero__row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 24px;
}

.hero__row--mid {
  justify-content: center;
  margin: 4vh 0;
}

.hero h1 {
  font-size: clamp(64px, 9vw, 170px);
  font-weight: 400;
  letter-spacing: -0.02em;
  line-height: 0.95;
  margin: 0;
  white-space: nowrap;
}

.parallax {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}

.pimg {
  position: absolute;
  left: var(--x);
  top: var(--y);
  width: var(--w);
  height: auto;
  transform: translate(-50%, -50%);
  will-change: transform;
  border-radius: 2px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
}

@media (max-width: 768px) {
  .hero {
    min-height: 72vh;
    padding-top: 10vh;
  }
  .hero__type {
    padding: 6vh 3vw 4vh;
  }
  .hero__row {
    flex-direction: column;
    align-items: flex-start;
  }
  .hero__row--mid {
    margin: 2vh 0;
    justify-content: flex-start;
  }
  .parallax {
    opacity: 0.55;
  }
  .pimg {
    width: calc(var(--w) * 0.85);
  }
}
#home h2 {
  margin: 80vh 0vw 15vh 0vw;
  font-family: "Abhaya Libre";
  @media (max-width: 768px) {
    margin: 45vh 0vw 50vh 20vw;
  }
}

/* RWD 下的 margin 設定 */
@media (max-width: 768px) {
  #home h2 {
    margin: 40vh 0vw 50vh 20vw;
  }
}

/* exp */
#exp,
#skill,
#intern,
#language {
  margin-top: 10vh;
}
#language {
  margin-bottom: 11vh;
}
.exp,
.skill,
.intern,
.language {
  margin-top: 1vh;
  margin-bottom: 2vh;
  width: 100%; /* 使其寬度自適應 */
}
.exp,
.date,
.theme,
.skill,
.item,
.detail {
  display: inline-block;
}
.date,
.item {
  width: 22%;
  @media (max-width: 768px) {
    width: 100%;
  }
}

/* projects */
#projects {
  margin-top: 30vh;
}
#projects a {
  text-decoration: none;
}
#projects h5 {
  padding: 2vh 0vw;
  color: var(--blue);
}
#projects .arrow {
  width: 30px;
}
#projects .banner {
  aspect-ratio: 16 / 9; /* 或 4 / 3，看你想要什麼比例 */
  overflow: hidden;
}

#projects .banner img {
  width: 100%;
  height: 100%;
  display: block;
}
.project-row {
  display: flex;
  gap: 16px; /* 卡片間距 */
}
@media (max-width: 768px) {
  .project-row {
    flex-wrap: wrap;
  }
}
.pro {
  padding: 20px 20px 20px 20px;
  transition: all 0.3s ease;
}
#projects a:hover {
  cursor: none;
}
.tag {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* works */
#works {
  margin-top: 30vh;
  display: flex; /* 使用 Flexbox 讓 work-left 和 work-right 並列 */
  justify-content: space-between; /* 確保兩個區塊之間有適當的空間 */
}
.work {
  margin-left: 10vw;
  display: flex;
  flex-wrap: nowrap;
}
.work img {
  width: 30vw;
}
.work .items {
  position: relative;
  height: 100%;
  overflow: hidden; /* 重點！ */
}
.work p {
  margin: -1vh 1vw 3vh 1vw;
  white-space: nowrap; /* 不換行 */
  width: fit-content;
  color: var(--blue);
  background-color: #fafafa99;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  font-weight: 400;
}
.work a {
  text-decoration: none;
}
#work-left,
#work-right {
  display: block;
  flex-wrap: wrap; /* 使內部元素換行 */
  justify-content: space-between; /* 在水平方向上分散排列 */
  width: 70%; /* 確保每個區塊佔 50% 寬度 */
}
#work-right {
  margin-top: 10vh;
  margin-left: 5vw;
}
#works a:hover {
  cursor: none;
}

@media (max-width: 768px) {
  .work {
    flex-wrap: wrap;
  }
  #work-left,
  #work-right {
    width: 100%; /* 確保每個區塊佔 50% 寬度 */
  }
  .work img {
    width: 80vw;
  }
  #work-right {
    margin-top: 0vh;
  }
}

/* articles */
#articles {
  margin-top: 30vh;
}
#articles a {
  text-decoration: none;
}
#articles h5 {
  color: var(--blue);
}
#articles img {
  width: 20px;
  align-items: end;
}
.articles-row {
  flex-direction: column;
  gap: 16px;
  border-bottom: 0.5px solid var(--blue); /* 請注意 var() 要有 -- 變數名稱 */
  padding-bottom: 4px;
  margin-bottom: 10px;
}

.article-item {
  display: inline-block;
  vertical-align: middle;
}

.article-date {
  display: inline-block;
}

.article-title {
  display: inline-block;
}

#articles a:hover {
  cursor: none;
}

html {
  scroll-behavior: smooth; /* 設置平滑滾動 */
}

#about,
#projects,
#works,
#articles {
  scroll-margin-top: 30vh; /* 將目標元素的上邊距設置為視窗高度的一半，將其垂直居中 */
}

/* HERO_NO_SCROLLBAR: prevent 1px/1vh overflow that creates the right scrollbar */
:root {
  /* fallback if main.css doesnt define them */
  --nav-h: 56px;
  --footer-h: 56px;
}
.hero {
  min-height: calc(100vh - var(--nav-h) - var(--footer-h));
}
