:root {
  --blue: rgb(50, 125, 255);
  --white: #fafafa;
  --black: #222222;
}

/* body img,
body video {
  border-radius: 10px;
} */
#banner img,
#banner video {
  margin-top: 4vh;
  border-radius: 0px;
}
body {
  margin: 0;
  font-family: "Noto Sans TC", "Helvetica", sans-serif;
  overflow-x: hidden;
  background-color: var(--white);
  color: var(--black);
  cursor: none;
}
body h4 {
  color: var(--blue);
  font-family: "Abhaya Libre";
  font-weight: 500;
  letter-spacing: 5%;
  padding-bottom: 3vh;
}
body a {
  color: var(--black);
}
body.dark-mode a {
  color: var(--white);
}
body.dark-mode .arrow-path {
  stroke: var(--white);
}
.forpc {
  display: block;
}
.forphone {
  display: none;
}
@media (max-width: 768px) {
  .forpc {
    display: none;
  }
  .forphone {
    display: block;
  }
}
/* .dark-mode {
  background-color: var(--black);
  color: var(--white);
} */
/* 重置與基礎樣式 */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}
html,
body {
  max-width: 100vw;
  overflow-x: hidden;
}
body {
  font-family: Arial, sans-serif;
  line-height: 1.6;
}

.container {
  width: 95%;
  margin: 0 auto;
  overflow: visible;
}

/* Flexbox Grid 系統 */
.row {
  display: flex;
  flex-wrap: wrap;
  margin-right: -15px;
  margin-left: -15px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

[class^="col-"],
[class*=" col-"] {
  padding-right: 5px;
  padding-left: 5px;
  box-sizing: border-box; /* 請確認這個有加！重要 */
}
* {
  box-sizing: border-box;
}

/* Grid 寬度設定 - 使用百分比 */
.col-md-1 {
  flex: 0 0 8.33%;
  max-width: 8.33%;
}
.col-md-2 {
  flex: 0 0 16.66%;
  max-width: 16.66%;
}
.col-md-3 {
  flex: 0 0 25%;
  max-width: 25%;
}
.col-md-4 {
  flex: 0 0 33.33%;
  max-width: 33.33%;
}
.col-md-5 {
  flex: 0 0 41.66%;
  max-width: 41.66%;
}
.col-md-6 {
  flex: 0 0 50%;
  max-width: 50%;
}
.col-md-7 {
  flex: 0 0 58.33%;
  max-width: 58.33%;
}
.col-md-8 {
  flex: 0 0 66.66%;
  max-width: 66.66%;
}
.col-md-9 {
  flex: 0 0 75%;
  max-width: 75%;
}
.col-md-10 {
  flex: 0 0 83.33%;
  max-width: 83.33%;
}
.col-md-11 {
  flex: 0 0 91.66%;
  max-width: 91.66%;
}
.col-md-12 {
  flex: 0 0 100%;
  max-width: 100%;
}

/* 偏移設定 - 使用百分比 */
.offset-md-1 {
  margin-left: 8.33%;
}
.offset-md-2 {
  margin-left: 16.66%;
}
.offset-md-3 {
  margin-left: 25%;
}
.offset-md-4 {
  margin-left: 33.33%;
}
.offset-md-5 {
  margin-left: 41.66%;
}
.offset-md-6 {
  margin-left: 50%;
}
.offset-md-7 {
  margin-left: 58.33%;
}
.offset-md-8 {
  margin-left: 66.66%;
}
.offset-md-9 {
  margin-left: 75%;
}
.offset-md-10 {
  margin-left: 83.33%;
}
.offset-md-11 {
  margin-left: 91.66%;
}
.offset-md-12 {
  margin-left: 100%;
}

/* 響應式設計：小於 768px 改為直向堆疊 */
@media (max-width: 768px) {
  .container {
    width: 97.5%;
    margin: 0 auto;
    overflow: visible;
    padding-left: 2.5vw;
  }
  .offset-md-1,
  .offset-md-2,
  .offset-md-3,
  .offset-md-4,
  .offset-md-5,
  .offset-md-6,
  .offset-md-7,
  .offset-md-8,
  .offset-md-9,
  .offset-md-10,
  .offset-md-11,
  .offset-md-12 {
    margin-left: 0 !important;
  }
  .col-1 {
    flex: 0 0 25%;
    max-width: 25%;
  }
  .col-2 {
    flex: 0 0 50%;
    max-width: 50%;
  }
  .col-3 {
    flex: 0 0 75%;
    max-width: 75%;
  }
  .col-4 {
    flex: 0 0 97.5%;
    max-width: 97.5%;
  }
}

/* 文字 & Flexbox 排列 */
.text-center {
  text-align: center;
}

.text-start {
  display: flex; /* 需要設為 flex 才能使用 justify-content */
  justify-content: flex-start; /* 讓內容置左 */
}

.text-end {
  display: flex; /* 確保箭頭所在的容器是 flex */
  justify-content: flex-end; /* 讓箭頭置右 */
}

/* 滑鼠藍色聚光燈效果 */
#spotlight {
  position: fixed;
  width: 10px;
  height: 10px;
  background: rgb(50, 125, 255, 0.6);
  pointer-events: none;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  /* filter: blur(5px); 更強的模糊效果 */
  mix-blend-mode: normal;
  transition:
    transform 0.2s ease-out,
    opacity 0.3s ease-in-out,
    mix-blend-mode 0.2s ease-out;
  z-index: 9999999999;
}

/* 鏡頭炫光效果 */
#lens-flare {
  position: fixed;
  top: 50%;
  left: -50%;
  width: 100vw;
  height: 100vh;
  background:
    radial-gradient(circle, rgba(0, 86, 235, 0.3) 0%, rgba(0, 86, 235, 0) 60%),
    radial-gradient(circle, rgba(0, 86, 235, 0.15) 10%, rgba(0, 86, 235, 0) 70%);

  filter: blur(80px) brightness(1.2) contrast(1.1);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.8s ease-in-out;
}

/* 滑動時讓炫光出現 */
body.scrolled #lens-flare {
  opacity: 1;
}

section {
  padding: 0 4vw;
}

h1 {
  font-size: 64px;
  font-weight: 700;
  letter-spacing: 5%;
}

h2 {
  font-size: 40px;
  font-weight: 700;
  letter-spacing: 5%;
}

h3 {
  font-size: 32px;
  font-weight: 600;
  letter-spacing: 5%;
}

h4 {
  font-size: 24px;
  font-weight: 500;
  letter-spacing: 5%;
}

h5 {
  font-size: 18px;
  font-weight: 400;
  letter-spacing: 5%;
}

p {
  font-size: 14px;
  font-weight: 300;
  letter-spacing: 10%;
  line-height: 180%;
}

.bold {
  font-weight: 400;
  letter-spacing: 2%;
}

/* navbar */
#nav {
  /* position: fixed !important; 保證固定在頁面上 */
  background-color: var(--white);
  height: 5vh;
  width: 100vw;
  position: fixed;
  border-bottom: 0.8px solid var(--blue);
  z-index: 999999999;
}
#nav .container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 1vh;
}

.en a,
.nav-item {
  text-decoration: none;
  background: none;
  color: var(--blue);
  border: none;
  font-size: 14px;
  font-weight: 300;
  letter-spacing: 10%;
  line-height: 180%;
  cursor: none;
}
.nav-item {
  text-decoration: none; /* 移除底線 */
  margin-left: 5vw;
  cursor: none;
}
.nav-item a,
.language a {
  color: var(--blue);
  cursor: none;
}

/*footer*/
#footer {
  background-color: var(--white);
  color: var(--blue);
  margin-top: 10vh;
  display: flex; /* 使用 Flexbox 布局 */
  justify-content: center; /* 水平居中 */
  align-items: center; /* 垂直居中 */
  height: 5vh; /* 设置 footer 的高度 */
}
#footer p {
  justify-content: center; /* 水平居中 */
  align-items: center; /* 垂直居中 */
  font-size: small;
}

/*aos*/
/* AOS: dont block clicks (was breaking panel click) */
[data-aos] {
  pointer-events: auto;
}
.aos-animate {
  pointer-events: auto;
}
.aos-init[data-aos][data-aos].aos-animate {
  transform: unset;
}

/* go top */
.go-top {
  background-color: transparent;
  position: fixed !important;
  bottom: 20px;
  right: 30px;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  cursor: none;
  border: 0.8px solid var(--blue);
  opacity: 0;
  visibility: hidden;
  transition: all 0.1s ease;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
@media (max-width: 768px) {
  .go-top {
    display: none;
  }
}

.go-top.show {
  opacity: 1;
  visibility: visible;
}

/* ===== LAYOUT_FIXED_BARS ===== */
:root {
  --nav-h: 56px;
  --footer-h: 56px;
}

body {
  padding-top: var(--nav-h);
  /* padding-bottom: var(--footer-h); */
}

/* header */
#nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: var(--nav-h);
  width: 100vw;
  z-index: 999999999;
}

#nav .container {
  height: 100%;
  display: flex;
  align-items: center;
  padding-top: 0; /* override old 1vh */
}

/* footer fixed */
#footer {
  position: sticky;
  left: 0;
  right: 0;
  bottom: 0;
  height: var(--footer-h);
  width: 100vw;
  margin-top: 0;
  z-index: 999999999;
}

/* if you keep wrapper containers, make sure they dont break layout */
.scroll-container {
  min-height: 100vh;
}

/* ===== AOS_SCROLL_CONTAINER_FIX ===== */
/* Ensure the page scroll is on window, not a nested container. */
.scroll-container {
  height: auto;
  overflow: visible;
}
body {
  overflow-y: auto;
}

/* ===== OFFCANVAS_PANEL_V2 ===== */
:root {
  /* 12-col grid -> 5 cols ≈ 41.666vw */
  --panel-w: min(560px, 41.666vw);
}

/* row hover + click affordance */
.panel-item {
  position: relative;
  cursor: none;
  border-radius: 10px;
  transition: background 0.15s ease, transform 0.15s ease;
}
.panel-item:hover {
  background: rgba(50, 125, 255, 0.06);
  transform: translateY(-1px);
}
.panel-item::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -10px;
  height: 1px;
  background: rgba(50, 125, 255, 0.12);
}

/* overlay */
.panel-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.1);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.18s ease;
  z-index: 999999990;
}

/* panel */
.panel {
  position: fixed;
  top: 0;
  right: 0;
  width: var(--panel-w);
  height: 100vh;
  background: var(--white);
  border-left: 0.8px solid var(--blue);
  transform: translate3d(100%, 0, 0);
  transition: transform 0.22s ease;
  z-index: 999999991;
  display: flex;
  flex-direction: column;
}

/* header */
.panel__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 18px;
  border-bottom: 0.8px solid rgba(50, 125, 255, 0.35);
}
.panel__header h3 {
  margin: 0;
  font-family: "Abhaya Libre";
  font-weight: 400;
  color: var(--blue);
}
.panel__close {
  border: 0.8px solid var(--blue);
  background: transparent;
  color: var(--blue);
  width: 36px;
  height: 36px;
  border-radius: 999px;
  line-height: 1;
  font-size: 20px;
  cursor: none;
}

/* body */
.panel__body {
  padding: 16px 18px 24px;
  overflow: auto;
}
.panel__body .meta {
  color: rgba(0, 0, 0, 0.55);
  font-size: 12px;
  margin-bottom: 8px;
}

/* open state */
body.panel-open .panel {
  transform: translate3d(0, 0, 0);
}
body.panel-open .panel-overlay {
  opacity: 1;
  pointer-events: auto;
}
body.panel-open {
  overflow: hidden;
}

@media (max-width: 768px) {
  :root {
    --panel-w: 100vw;
  }
}
